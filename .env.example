# ── Supabase / PostgreSQL ──────────────────────────────────
# Session Pooler (preferido) o Direct Connection.
# NO usar Transaction Pooler con asyncpg (rompe prepared statements).
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# ── LiteLLM / LLM Providers ───────────────────────────────
# Provider por defecto. Valores típicos: anthropic, openai, nvidia_nim, lm_studio
LLM_DEFAULT_PROVIDER=anthropic

# API keys por proveedor (se cifran en reposo en DB, aquí solo para bootstrap inicial)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
NVIDIA_NIM_API_KEY=nvapi-...
LM_STUDIO_API_BASE=http://localhost:1234/v1

# ── Auth / JWT ────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── APScheduler ───────────────────────────────────────────
SCRAPE_INTERVAL_HOURS=6

# ── App ───────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000