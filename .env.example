# 🚀 Freebuff - FastAPI Backend Environment Variables
# Copy this file to .env and fill in your values
#   Linux/macOS: cp .env.example .env
#   Windows:     copy .env.example .env
#
# The app reads settings from environment variables or .env file
# (see app/core/settings.py for the full Settings model).

# ════════════════════════════════════════════════════════════════
# Supabase / PostgreSQL
# ════════════════════════════════════════════════════════════════
# Session Pooler (preferido) o Direct Connection.
# NO usar Transaction Pooler con asyncpg (rompe prepared statements).
DATABASE_URL=postgresql://postgres.sbeofjqviakuhnfcqvgo:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ════════════════════════════════════════════════════════════════
# LiteLLM / LLM Providers (API Keys)
# ════════════════════════════════════════════════════════════════
# Provider por defecto. Valores típicos: anthropic, openai, nvidia_nim, lm_studio, ollama
LLM_DEFAULT_PROVIDER=anthropic

# Las API keys NO van aquí — se registran desde el front vía /providers
# y se guardan cifradas (Fernet) en la DB por usuario.
# Las variables siguientes son solo fallback si no hay credencial en DB:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
NVIDIA_NIM_API_KEY=

# Base URL para LM Studio (servidor local de inferencia)
LM_STUDIO_API_BASE=http://localhost:1234/v1

# ════════════════════════════════════════════════════════════════
# Auth / JWT
# ════════════════════════════════════════════════════════════════
# Secret key para firmar tokens JWT. CAMBIAR en producción.
JWT_SECRET_KEY=change-me-to-a-random-64-char-string

# Algoritmo de firma JWT
JWT_ALGORITHM=HS256

# Expiración del token en minutos (1440 = 24 horas)
JWT_EXPIRE_MINUTES=1440

# ════════════════════════════════════════════════════════════════
# APScheduler
# ════════════════════════════════════════════════════════════════
# Intervalo del scraper automático (en horas)
SCRAPE_INTERVAL_HOURS=6

# ════════════════════════════════════════════════════════════════
# Resend (Transactional Email)
# ════════════════════════════════════════════════════════════════
# API key de Resend (https://resend.com) para emails transaccionales
RESEND_API_KEY=

# Dirección "from" para los correos (usa un dominio verificado en Resend)
RESEND_FROM_EMAIL=noreply@tonyml.com

# Email del administrador para recibir solicitudes de contacto
ADMIN_EMAIL=ai-jobs@tonyml.com

# ════════════════════════════════════════════════════════════════
# Rate Limiting (Intentos de login)
# ════════════════════════════════════════════════════════════════
# Máximo de intentos fallidos antes del bloqueo temporal
RATE_LIMIT_ATTEMPTS=5

# Ventana de rate limiting en segundos (900 = 15 minutos)
RATE_LIMIT_WINDOW_SECONDS=900

# ════════════════════════════════════════════════════════════════
# i18n (Internationalization)
# ════════════════════════════════════════════════════════════════
# Idioma por defecto: en, es, etc.
DEFAULT_LANGUAGE=en

# ════════════════════════════════════════════════════════════════
# Sentry (Error Tracking)
# ════════════════════════════════════════════════════════════════
# https://sentry.io — crea proyecto FastAPI, copia el DSN. Vacío = desactivado.
SENTRY_DSN=

# ════════════════════════════════════════════════════════════════
# App
# ════════════════════════════════════════════════════════════════
# Entorno: development, production, testing
APP_ENV=development

# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Orígenes CORS permitidos (separados por coma).
# Local: http://localhost:3000
# Producción: https://tudominio.com
CORS_ORIGINS=http://localhost:3000

# ════════════════════════════════════════════════════════════════
# Paths (rutas relativas al proyecto, a menos que sean absolutas)
# ════════════════════════════════════════════════════════════════
# Directorio para documentos de usuario
DOCUMENTS_DIR=documents

# Ruta al archivo JSON del tracker de aplicaciones
TRACKER_PATH=documents/tracker.json

# ════════════════════════════════════════════════════════════════
# Orchestrator
# ════════════════════════════════════════════════════════════════
# Máximo de workers LLM concurrentes en la cola de ejecución
ORCHESTRATOR_MAX_CONCURRENCY=4

# ════════════════════════════════════════════════════════════════
# LaTeX
# ════════════════════════════════════════════════════════════════
# Directorio con binarios de LaTeX (lualatex, xelatex, pdfinfo, pdftotext).
# Vacío = usa binarios del PATH del sistema.
# Para MiKTeX Portable: app/external/latex/miktex-portable/miktex/bin/x64
LATEX_BIN_DIR=app/external/latex/miktex-portable/miktex/bin/x64
